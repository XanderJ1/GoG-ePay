{
  "name": "gog-epay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-site.mjs --production",
    "preview": "node scripts/serve-build.mjs",
    "check": "node scripts/check-site.mjs",
    "format": "prettier --write site scripts tests playwright.config.js package.json",
    "test": "node --test tests/config.test.mjs",
    "build:production": "node scripts/build-site.mjs --production",
    "build:preview": "node scripts/build-site.mjs",
    "test:seo": "node --test tests/seo-output.test.mjs",
    "test:browser": "playwright test",
    "serve:build": "node scripts/serve-build.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "check:content": "node scripts/check-content.mjs",
    "audit:live": "node scripts/audit-live.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "measure:mobile": "node scripts/measure-mobile.mjs",
    "assets:brand": "node scripts/generate-favicons.mjs && node scripts/generate-social-card.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "bootstrap-icons": "^1.13.2"
  }
}

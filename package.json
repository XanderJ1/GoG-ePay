{
	"name": "gog-epay",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/build-site.mjs --production",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"test": "node --test tests/config.test.mjs",
		"build:production": "node scripts/build-site.mjs --production",
		"build:preview": "node scripts/build-site.mjs",
		"test:seo": "node --test tests/seo-output.test.mjs",
		"test:browser": "playwright test",
		"serve:build": "node scripts/serve-build.mjs",
		"indexnow": "node scripts/indexnow.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/enhanced-img": "^0.8.4",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.0"
	},
	"overrides": {
		"sharp": "^0.35.5",
		"cookie": "^0.7.2"
	},
	"dependencies": {
		"bootstrap-icons": "^1.13.2"
	}
}
